{
  "name": "haltd",
  "displayName": "Haltd",
  "description": "STM32 debugging through a long-running J-Link backend",
  "version": "0.7.1",
  "publisher": "WaterKeyqwq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Waterkey3rd/Haltd.git"
  },
  "homepage": "https://github.com/Waterkey3rd/Haltd#readme",
  "bugs": {
    "url": "https://github.com/Waterkey3rd/Haltd/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:haltd",
    "onLanguage:jsonc",
    "workspaceContains:.vscode/launch.json",
    "onCommand:haltd.selectDevice"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "c"
      },
      {
        "language": "cpp"
      }
    ],
    "debuggers": [
      {
        "type": "haltd",
        "label": "J-Link (Haltd)",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "device",
              "elf"
            ],
            "properties": {
              "device": {
                "type": "string",
                "description": "J-Link device name, such as STM32H723VG.",
                "examples": [
                  "STM32H723VG",
                  "STM32H743ZI",
                  "STM32G474RE",
                  "STM32F103C8",
                  "STM32F407VG",
                  "STM32L476RG"
                ]
              },
              "interface": {
                "type": "string",
                "enum": [
                  "SWD",
                  "JTAG"
                ],
                "default": "SWD"
              },
              "speed": {
                "type": [
                  "number",
                  "string"
                ],
                "default": 4000,
                "description": "Interface clock in kHz, or \"auto\"."
              },
              "elf": {
                "type": "string",
                "default": "${workspaceFolder}/build/firmware.elf"
              },
              "flash": {
                "type": "string",
                "enum": [
                  "always",
                  "changed",
                  "never"
                ],
                "default": "changed"
              },
              "runToMain": {
                "type": "boolean",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "project": {
                "type": "string",
                "default": "${workspaceFolder}/.haltd/project.yaml"
              },
              "svd": {
                "type": "string",
                "description": "CMSIS-SVD file for the Peripherals view. Found in an installed Ozone when omitted."
              },
              "dll": {
                "type": "string",
                "description": "Path of the J-Link library. The installed J-Link software is used when omitted."
              },
              "serial": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Serial number of the J-Link to use when several are attached."
              },
              "rtt": {
                "type": "object",
                "description": "RTT auto-decoding and Timeline options for channels not configured in .haltd/rtt.yaml.",
                "properties": {
                  "autoDecode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically decode unconfigured RTT channels matching ELF struct types or key=value text."
                  },
                  "autoTimeline": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically add auto-decoded RTT signals to the Timeline."
                  }
                }
              }
            }
          },
          "attach": {
            "required": [
              "device",
              "elf"
            ],
            "properties": {
              "device": {
                "type": "string",
                "description": "J-Link device name, such as STM32H723VG.",
                "examples": [
                  "STM32H723VG",
                  "STM32H743ZI",
                  "STM32G474RE",
                  "STM32F103C8",
                  "STM32F407VG",
                  "STM32L476RG"
                ]
              },
              "interface": {
                "type": "string",
                "enum": [
                  "SWD",
                  "JTAG"
                ],
                "default": "SWD"
              },
              "speed": {
                "type": [
                  "number",
                  "string"
                ],
                "default": 4000
              },
              "elf": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "svd": {
                "type": "string",
                "description": "CMSIS-SVD file for the Peripherals view. Found in an installed Ozone when omitted."
              },
              "dll": {
                "type": "string",
                "description": "Path of the J-Link library. The installed J-Link software is used when omitted."
              },
              "serial": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Serial number of the J-Link to use when several are attached."
              },
              "rtt": {
                "type": "object",
                "description": "RTT auto-decoding and Timeline options for channels not configured in .haltd/rtt.yaml.",
                "properties": {
                  "autoDecode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically decode unconfigured RTT channels matching ELF struct types or key=value text."
                  },
                  "autoTimeline": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically add auto-decoded RTT signals to the Timeline."
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "haltd",
            "request": "launch",
            "name": "Debug (J-Link)",
            "device": "STM32H723VG",
            "interface": "SWD",
            "speed": 4000,
            "elf": "${workspaceFolder}/build/firmware.elf",
            "flash": "changed"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "haltd.buildAndReload",
        "title": "Haltd: Build & Reload"
      },
      {
        "command": "haltd.addToWatch",
        "title": "Add to Live Watch",
        "icon": "$(add)"
      },
      {
        "command": "haltd.addToTimeline",
        "title": "Add to Timeline (HSS)"
      },
      {
        "command": "haltd.removeWatch",
        "title": "Remove",
        "icon": "$(close)"
      },
      {
        "command": "haltd.setWatchRate",
        "title": "Set Refresh Rate (0-5 Hz)",
        "icon": "$(dashboard)"
      },
      {
        "command": "haltd.writeWatch",
        "title": "Set Value",
        "icon": "$(edit)"
      },
      {
        "command": "haltd.openTimeline",
        "title": "Haltd: Open Timeline",
        "icon": "$(graph-line)"
      },
      {
        "command": "haltd.openTimelineInBrowser",
        "title": "Haltd: Open Timeline in Browser"
      },
      {
        "command": "haltd.startRecording",
        "title": "Haltd: Start/Stop Recording"
      },
      {
        "command": "haltd.showStats",
        "title": "Haltd: Show Statistics"
      },
      {
        "command": "haltd.openRttTerminal",
        "title": "Haltd: Open RTT Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "haltd.openRttPanel",
        "title": "Haltd: Open RTT Signals"
      },
      {
        "command": "haltd.refreshPeripherals",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "haltd.readRegister",
        "title": "Read Register Now",
        "icon": "$(eye)"
      },
      {
        "command": "haltd.writePeripheral",
        "title": "Set Value",
        "icon": "$(edit)"
      },
      {
        "command": "haltd.refreshTasks",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "haltd.selectDevice",
        "title": "Haltd: Select Device"
      },
      {
        "command": "haltd.addSelectionToWatch",
        "title": "Haltd: Add Selection to Live Watch"
      },
      {
        "command": "haltd.addSelectionToTimeline",
        "title": "Haltd: Add Selection to Timeline (HSS)"
      },
      {
        "command": "haltd.removeSelectedWatch",
        "title": "Remove Selected from Live Watch"
      },
      {
        "command": "haltd.editSelectedWatch",
        "title": "Edit Selected Live Watch Value"
      },
      {
        "command": "haltd.setSelectedWatchRate",
        "title": "Set Selected Live Watch Refresh Rate"
      },
      {
        "command": "haltd.copySelectedWatch",
        "title": "Copy Selected Live Watch Value"
      }
    ],
    "keybindings": [
      {
        "command": "haltd.buildAndReload",
        "key": "f6",
        "when": "debugType == haltd"
      },
      {
        "command": "haltd.addSelectionToWatch",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "inDebugMode && debugType == 'haltd' && editorTextFocus"
      },
      {
        "command": "haltd.addSelectionToTimeline",
        "args": "editor",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "inDebugMode && debugType == 'haltd' && editorTextFocus"
      },
      {
        "command": "haltd.addSelectionToTimeline",
        "args": "liveWatch",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "inDebugMode && debugType == 'haltd' && focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.removeSelectedWatch",
        "key": "delete",
        "mac": "backspace",
        "when": "focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.editSelectedWatch",
        "key": "f2",
        "when": "focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.editSelectedWatch",
        "args": "enter",
        "key": "enter",
        "when": "focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.setSelectedWatchRate",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.copySelectedWatch",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == 'haltd.liveWatch'"
      },
      {
        "command": "haltd.openTimeline",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "debugType == 'haltd'"
      }
    ],
    "configuration": {
      "title": "Haltd",
      "properties": {
        "haltd.path": {
          "type": "string",
          "default": "haltd",
          "description": "Path of the haltd executable."
        },
        "haltd.replaceWatchView": {
          "type": "boolean",
          "default": true,
          "description": "Hide the built-in Watch view during Haltd sessions, since Add to Watch goes to Live Watch instead."
        }
      }
    },
    "views": {
      "debug": [
        {
          "id": "haltd.liveWatch",
          "name": "Live Watch",
          "visibility": "visible"
        },
        {
          "id": "haltd.tasks",
          "name": "FreeRTOS Tasks",
          "when": "debugType == haltd"
        },
        {
          "id": "haltd.peripherals",
          "name": "Peripherals",
          "when": "debugType == haltd"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "haltd.addToTimeline",
          "when": "inDebugMode && debugType == haltd",
          "group": "debug@11"
        }
      ],
      "debug/variables/context": [
        {
          "command": "haltd.addToTimeline",
          "when": "debugType == haltd",
          "group": "z_haltd@2"
        }
      ],
      "view/title": [
        {
          "command": "haltd.addToWatch",
          "when": "view == haltd.liveWatch",
          "group": "navigation@1"
        },
        {
          "command": "haltd.openTimeline",
          "when": "view == haltd.liveWatch",
          "group": "navigation@2"
        },
        {
          "command": "haltd.openRttTerminal",
          "when": "view == haltd.liveWatch",
          "group": "navigation@3"
        },
        {
          "command": "haltd.refreshPeripherals",
          "when": "view == haltd.peripherals",
          "group": "navigation"
        },
        {
          "command": "haltd.refreshTasks",
          "when": "view == haltd.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "haltd.setWatchRate",
          "when": "view == haltd.liveWatch",
          "group": "inline@0"
        },
        {
          "command": "haltd.writeWatch",
          "when": "view == haltd.liveWatch && viewItem == watchWritable",
          "group": "inline@1"
        },
        {
          "command": "haltd.removeWatch",
          "when": "view == haltd.liveWatch && !listMultiSelection",
          "group": "inline@2"
        },
        {
          "command": "haltd.addToTimeline",
          "when": "view == haltd.liveWatch",
          "group": "1_haltd@1"
        },
        {
          "command": "haltd.setWatchRate",
          "when": "view == haltd.liveWatch",
          "group": "1_haltd@2"
        },
        {
          "command": "haltd.readRegister",
          "when": "view == haltd.peripherals && viewItem =~ /sideEffects/",
          "group": "inline"
        },
        {
          "command": "haltd.writePeripheral",
          "when": "view == haltd.peripherals && viewItem =~ /writable/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "haltd.removeWatch",
          "when": "false"
        },
        {
          "command": "haltd.setWatchRate",
          "when": "false"
        },
        {
          "command": "haltd.writeWatch",
          "when": "false"
        },
        {
          "command": "haltd.readRegister",
          "when": "false"
        },
        {
          "command": "haltd.writePeripheral",
          "when": "false"
        },
        {
          "command": "haltd.addSelectionToWatch",
          "when": "false"
        },
        {
          "command": "haltd.addSelectionToTimeline",
          "when": "false"
        },
        {
          "command": "haltd.removeSelectedWatch",
          "when": "false"
        },
        {
          "command": "haltd.editSelectedWatch",
          "when": "false"
        },
        {
          "command": "haltd.setSelectedWatchRate",
          "when": "false"
        },
        {
          "command": "haltd.copySelectedWatch",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "@types/ws": "^8.5.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
